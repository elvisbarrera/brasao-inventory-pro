# Supabase Configuration (public, used in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API key: set this in Netlify environment variables (scope: Functions),
# NOT in the browser bundle. Used by netlify/functions/scan-inventory.mts
GEMINI_API_KEY=your-gemini-api-key
